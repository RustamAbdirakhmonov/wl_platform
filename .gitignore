# =========================
# Miscellaneous
# =========================
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db

.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# =========================
# IntelliJ / Android Studio
# =========================
*.iml
*.ipr
*.iws
.idea/

# VS Code (uncomment if you don't want to track it)
#.vscode/
.vscode/.history/

# =========================
# Flutter / Dart / Pub
# =========================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
.packages
.pub/
.pub-cache/
coverage/
**/doc/api/

# Build outputs (root + nested packages/apps)
build/
**/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# =========================
# Android
# =========================
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/**/GeneratedPluginRegistrant.java

# Android build artifacts (usually not needed in git)
*.apk
*.aab

# Android Studio will place build artifacts here (redundant with build/, but ok)
android/app/debug/
android/app/profile/
android/app/release/

# Keystores / certs (IMPORTANT: don't commit)
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/*.der

# =========================
# iOS / macOS
# =========================
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*

**/macos/Pods/
**/macos/Flutter/ephemeral/
**/macos/Runner/GeneratedPluginRegistrant.*

# Xcode user files
**/*.xcuserstate
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
DerivedData/

# =========================
# Web
# =========================
**/web/.dart_tool/
**/web/build/

# =========================
# Env / secrets (keep example file)
# =========================
.env
.env.*
!.env.example

# Firebase configs (uncomment if you don't want to commit them)
# **/google-services.json
# **/GoogleService-Info.plist

# =========================
# Keep empty package folders
# =========================
!.gitkeep
